# Base de données PostgreSQL
DATABASE_URL=postgres://omniscore:omniscore@localhost:5432/omniscore

# Secret de signature des sessions (32 caractères minimum) : openssl rand -base64 32
SESSION_SECRET=

# Source des prédictions : l'API FastAPI du moteur (backend/)...
OMNISCORE_API_URL=
# ...ou, à défaut, les fichiers JSON du moteur : web/data (copié au build depuis ../backend/data)
# ou le dossier indiqué ici.
OMNISCORE_DATA_DIR=../backend/data

# Synchronisation automatique toutes les N minutes (0 = désactivée) et secret de la route /api/cron/sync
SYNC_INTERVAL_MINUTES=10
CRON_SECRET=

# Paiement Stripe (optionnel : sans clé, l'offre Pro n'est pas proposée)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
APP_URL=http://localhost:3000
